<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs ratchet baseline (P1-T14): the EI_EXPOSE_REP* findings that existed when the gate
  became blocking. Matched by source file, so a class's Lombok builder is covered too.
  Only remove names from this file (P1-T19); fix new findings instead of adding them here.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!-- Spring beans: SpotBugs flags constructor-injected collaborators -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Source name="~(SecurityConfig|ChannelController|ApiAuthenticationEntryPoint|JwtAuthFilter)\.java"/>
      <Source name="~(RawWebSocketHandler|WsRealtimeEmitterAdapter)\.java"/>
      <Source name="~(Auth|Member|Message|S3Storage)Adapter\.java"/>
      <Source name="~(AuthenticateUser|Media|RefreshToken|User|Channel|Message|WsSendMessage|WsSubscribe)Service\.java"/>
      <Source name="~Abstract(Channel|Message)CreationStrategy\.java"/>
    </Or>
  </Match>

  <!-- Mutable models: Lombok getters/setters/builders over Date and List fields -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <!-- domain -->
      <Source name="~(Channel|ChannelListPage|AddMembersCommand|CreateChannelCommand)\.java"/>
      <Source name="~(Message|MessageList|Member)\.java"/>
      <!-- web DTOs -->
      <Source name="~(AddMembersRequest|CreateChannelRequest|GetChannelResponse|GetMessagesResponse)\.java"/>
      <Source name="~(ApiErrorResponse|ApiSuccessResponse)\.java"/>
      <!-- JPA entities -->
      <Source name="~(Channel|AuthProvider|FriendRequest|Topic|Media|Member|Message)Entity\.java"/>
    </Or>
  </Match>
</FindBugsFilter>
