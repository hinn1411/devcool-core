# Local credentials for docker/local/compose.yaml.
# Copy to docker/local/.env (ignored by git) and replace every "change-me".
# Compose refuses to start while a variable is missing.

POSTGRES_DB=devcool
POSTGRES_USER=devcool
POSTGRES_PASSWORD=change-me

PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=change-me
